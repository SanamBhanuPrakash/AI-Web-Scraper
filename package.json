{
  "name": "digest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @digest/api",
    "dev:web": "npm run dev -w @digest/web",
    "build": "npm run build -w @digest/web",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w @digest/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "hygiene": "node scripts/check-hygiene.mjs && node scripts/secret-scan.mjs",
    "check": "npm run hygiene && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
