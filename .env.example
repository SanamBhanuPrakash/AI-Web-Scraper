# Copy this file to `.env` (repo root) and fill in. `.env` is git-ignored. NEVER commit real keys.
# The frontend never reads this file; only the API process does.

# --- AI providers (at least one required unless DIGEST_MOCK_LLM=1) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Model ids are configurable because providers rename/deprecate models. Verified defaults are set in M0-5.
GEMINI_MODEL=
GROQ_MODEL=
# Order of fallback, comma separated.
LLM_PROVIDER_ORDER=gemini,groq

# --- Demo / offline mode: runs the whole pipeline with a deterministic fake summarizer (no keys needed) ---
DIGEST_MOCK_LLM=0

# --- Optional shared cache + rate limiting (Upstash Redis REST). Leave empty to use in-memory fallbacks ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tunables (defaults shown) ---
RATE_LIMIT_PER_MIN=6
FETCH_TIMEOUT_MS=10000
MAX_HTML_BYTES=2000000
LOG_LEVEL=info
PORT=8787
