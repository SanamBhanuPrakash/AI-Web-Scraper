# Copy this file to `.env` in the REPOSITORY ROOT (next to package.json) and fill it in.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# `.env` is git-ignored. NEVER put real keys in this example file: it is committed.
# Only the API process reads this file. The frontend never sees it and has no secrets.

# --- AI providers: at least one key, unless DIGEST_MOCK_LLM=1 ---
# Free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Model ids change over time, so they are configurable. Defaults were verified against the live APIs.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=qwen/qwen3.8-27b

# Fallback order, comma separated. A provider without a key is skipped.
LLM_PROVIDER_ORDER=gemini,groq
# size-aware: pages small enough for the fast provider (Groq) try it first (about 1 s end to end);
#             longer pages go to the larger-context provider first. ordered: use LLM_PROVIDER_ORDER as written.
LLM_ROUTING=size-aware

# --- Offline demo mode: runs the whole pipeline with a simple extractive summarizer, no keys needed ---
# `npm run dev` turns this on automatically when no key is present.
DIGEST_MOCK_LLM=0

# --- Optional shared cache + rate limiting (free Upstash Redis, REST) ---
# Without these the app uses per-instance memory, which is fine locally but only best-effort on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tunables (defaults shown) ---
# RATE_LIMIT_PER_MIN=6          requests per client per minute
# FETCH_TIMEOUT_MS=10000        total time allowed to download a page (including redirects)
# MAX_HTML_BYTES=2000000        largest page we will download (after decompression)
# GEMINI_MAX_INPUT_CHARS=150000 page text sent to Gemini (longer pages keep the opening and the end)
# GROQ_MAX_INPUT_CHARS=14000    smaller because Groq's free tier limits tokens per minute
# FIRST_TOKEN_TIMEOUT_MS=5000   if a model has produced nothing by then, try the next provider
# LLM_TOTAL_TIMEOUT_MS=30000    ceiling for one model's whole answer
# LOG_LEVEL=info                debug | info | warn | error
# PORT=8787                     local API port
# TRUST_PROXY=                  1 only behind a proxy you trust (set automatically on Vercel)
